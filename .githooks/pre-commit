#!/bin/sh
# 提交前把关：跑一遍项目体检（等价于 npm run health），有 FAIL 就中止这次提交。
#
# 启用方式（仓库已通过 core.hooksPath 指向本目录）：
#   git config core.hooksPath .githooks
#
# 为什么优先直接调 node，而不是 npm run health：
#   体检脚本本身就是一个 node 脚本，npm 只是转发。而 npm 并非处处可用 ——
#   有的机器上 npm 会被劫持到一个起不来的进程里，症状是「提交卡住不动、
#   最后被 SIGTERM 掐掉」，看着像钩子坏了，其实是 npm 没跑起来。
#   所以有裸 node 就直接跑脚本，确实没有才退回 npm。
#
# 临时跳过（不推荐，会让问题进库）：
#   git commit --no-verify

echo "→ 提交前体检：scripts/health-check.mjs"
echo ""

if command -v node >/dev/null 2>&1; then
  node scripts/health-check.mjs
else
  npm run health
fi

if [ $? -ne 0 ]; then
  echo ""
  echo "体检未通过，本次提交已中止。"
  echo "修复上面的 FAIL 后重试；确需跳过用：git commit --no-verify"
  exit 1
fi

exit 0
