# 把这个文件复制一份、改名为 .env，再把 SECRET_KEY 换成你自己随机生成的一串字符（至少 16 位）。
# 生成办法（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   或者随便敲 32 个以上的随机字符
SECRET_KEY=换成一串你自己的随机字符至少16位

# 签名算法，一般不用改
ALGORITHM=HS256

# token 有效期（分钟）。改小一点方便测试过期，比如 1。
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 允许跨域的前端来源（逗号分隔）。前后端同域名部署时其实用不上，
# 留着是为了以后换域名时不用改代码。本地开发也可以把它设成 http://localhost:5173。
CORS_ORIGINS=https://learnailab.cn,https://www.learnailab.cn

# 数据库地址。留空 = 用 backend/data/app.db（推荐，够用）。
# 只有当你想把数据放到别的盘 / 系统目录时才写，注意 sqlite 后面是【四个斜杠】：
# DATABASE_URL=sqlite:////var/lib/blog/app.db
